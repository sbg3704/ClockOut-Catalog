{
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git fetch:*)", "Bash(git pull:*)",
      "Bash(python tools/gen_colibapi.py --check:*)"
    ],
    "ask": [
      "Bash(git merge:*)", "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push --force-with-lease:*)",
      "Bash(gh release create:*)", "Bash(gh release upload:*)", "Bash(gh release delete:*)"
    ]
  }
}
